{
    "name": "alcaparra-monaco",
    "version": "0.1.0",
    "description": "Soporte de AlcaparraLang para Monaco Editor: gramática, configuración de lenguaje y diagnósticos",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/mongoose-studio/alcaparra-monaco"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./grammar": "./syntaxes/caper.tmLanguage.json",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "syntaxes",
        "language-configuration.json"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "node --test \"test/*.test.js\"",
        "prepare": "npm run build"
    },
    "peerDependencies": {
        "monaco-editor": ">=0.45.0",
        "shiki": "^4.0.0"
    },
    "dependencies": {
        "@shikijs/monaco": "^4.6.0"
    },
    "devDependencies": {
        "monaco-editor": "^0.58.0",
        "shiki": "^4.6.0",
        "tsup": "^8.5.0",
        "typescript": "~5.9.2"
    }
}
